# ============================================
# ForexPredictBot AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# ── Anthropic AI (optional) ──────────────────
# Enables AI-powered follow-up chat in the trading bot.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Security ─────────────────────────────────
# JWT secret key — change this in production!
SECRET_KEY=forex-predict-bot-secret-change-in-production-xyz-2024

# ── Database ─────────────────────────────────
# SQLite (default) — no setup needed.
# For PostgreSQL: postgresql://user:password@localhost/forexpredictbot
DATABASE_URL=sqlite:///./forexpredictbot.db

# ── Server Config ────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_APP_NAME=ForexPredictBot AI
NEXT_PUBLIC_API_URL=http://localhost:8000
