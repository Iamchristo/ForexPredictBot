[Unit]
Description=Telegram Scraper & Bulk Messenger - Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ForexPredictBot/telegram-tool
EnvironmentFile=/home/ubuntu/ForexPredictBot/telegram-tool/.env
ExecStart=/home/ubuntu/ForexPredictBot/telegram-tool/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
